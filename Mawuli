<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flotation Bench — Reagent Bonding Explorer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --charcoal:#1C1B19; --panel:#242220; --panel-2:#2C2A27; --panel-3:#332F2B;
  --ochre:#B8863B; --ochre-bright:#D9A24E; --ochre-dim:#8A6530;
  --evidence:#3E7C7C; --evidence-bright:#5FAFAF; --evidence-dim:#2C5858;
  --mineral-white:#EDE7DD; --text-dim:#9A9488; --text-mid:#C4BEB2;
  --warn:#B85C3B; --good:#7A9B5C; --conflict:#C24E4E; --conflict-bg:#3A2320;
  --border:#3A3733; --border-bright:#4A453F;
  --radius:3px;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0; background:var(--charcoal); color:var(--mineral-white);
  font-family:'Space Grotesk',sans-serif; font-size:15px; line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
.mono{font-family:'JetBrains Mono',monospace;}
::selection{background:var(--ochre-dim); color:var(--mineral-white);}

/* ---------- header ---------- */
header{
  padding:28px 32px 20px; border-bottom:1px solid var(--border);
  display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:16px;
}
header h1{
  font-size:22px; font-weight:600; margin:0 0 4px; letter-spacing:-0.01em;
}
header .sub{
  font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--text-dim);
  text-transform:uppercase; letter-spacing:0.08em;
}
.legend{display:flex; gap:18px; font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--text-mid);}
.legend span{display:inline-flex; align-items:center; gap:6px;}
.dot{width:8px; height:8px; border-radius:50%; display:inline-block;}
.dot.theory{background:var(--ochre-bright);}
.dot.evidence{background:var(--evidence-bright);}

/* ---------- controls ---------- */
.controls{
  padding:20px 32px; border-bottom:1px solid var(--border); background:var(--panel);
  display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:20px;
}
.control-group label{
  display:block; font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--text-dim);
  text-transform:uppercase; letter-spacing:0.07em; margin-bottom:7px;
}
select, .slider-row input[type=range]{width:100%;}
select{
  background:var(--panel-2); color:var(--mineral-white); border:1px solid var(--border-bright);
  border-radius:var(--radius); padding:9px 10px; font-family:'Space Grotesk',sans-serif; font-size:14px;
}
.slider-row{display:flex; align-items:center; gap:10px;}
.slider-row input[type=range]{accent-color:var(--ochre-bright);}
.slider-val{
  font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--ochre-bright);
  min-width:64px; text-align:right; flex-shrink:0;
}
.slider-note{font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--text-dim); margin-top:5px; line-height:1.4;}
.slider-note.warn{color:var(--warn);}

/* ---------- main layout ---------- */
main{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--border);}
@media (max-width:900px){ main{grid-template-columns:1fr;} }

.panel{background:var(--charcoal); padding:24px 28px 32px; min-height:100px;}
.panel-head{
  display:flex; align-items:center; gap:10px; margin-bottom:18px;
  padding-bottom:14px; border-bottom:1px solid var(--border);
}
.panel-head .dot{width:10px; height:10px;}
.panel-head h2{font-size:15px; font-weight:600; margin:0; letter-spacing:0.01em;}
.panel-head .tag{
  font-family:'JetBrains Mono',monospace; font-size:9.5px; text-transform:uppercase; letter-spacing:0.08em;
  padding:3px 7px; border-radius:2px; margin-left:auto;
}
.panel.theory .panel-head .tag{background:rgba(184,134,59,0.15); color:var(--ochre-bright); border:1px solid var(--ochre-dim);}
.panel.evidence .panel-head .tag{background:rgba(62,124,124,0.15); color:var(--evidence-bright); border:1px solid var(--evidence-dim);}

.scope-note{
  font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--text-dim);
  background:var(--panel); border-left:2px solid var(--border-bright); padding:10px 12px;
  margin-bottom:18px; line-height:1.5;
}

/* ---------- theory panel internals ---------- */
.strength-readout{
  display:flex; align-items:baseline; gap:12px; margin-bottom:16px;
}
.strength-value{font-size:26px; font-weight:600; letter-spacing:-0.01em;}
.strength-value.strong{color:var(--good);}
.strength-value.moderate-to-strong{color:var(--ochre-bright);}
.strength-value.weak-to-moderate{color:var(--warn);}
.strength-value.weak{color:var(--conflict);}
.strength-label{font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.06em;}

.diagram-wrap{
  background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
  padding:16px; margin-bottom:18px;
}
.pzc-bar{position:relative; height:34px; background:var(--panel-2); border-radius:2px; margin:10px 0 6px; overflow:visible;}
.pzc-bar .zone{position:absolute; top:0; bottom:0; border-radius:2px;}
.pzc-bar .zone.pos{background:linear-gradient(90deg, rgba(184,92,59,0.35), rgba(184,92,59,0.1)); left:0;}
.pzc-bar .zone.neg{background:linear-gradient(90deg, rgba(95,175,175,0.1), rgba(95,175,175,0.35)); right:0;}
.pzc-bar .marker{
  position:absolute; top:-6px; width:2px; height:46px; background:var(--mineral-white);
}
.pzc-bar .marker.ph-marker{background:var(--ochre-bright); width:3px;}
.pzc-bar .marker .mtag{
  position:absolute; top:-20px; left:50%; transform:translateX(-50%);
  font-family:'JetBrains Mono',monospace; font-size:9.5px; white-space:nowrap;
}
.pzc-axis{display:flex; justify-content:space-between; font-family:'JetBrains Mono',monospace; font-size:9.5px; color:var(--text-dim);}

.mech-list{list-style:none; padding:0; margin:0 0 16px; font-size:13.5px; color:var(--text-mid);}
.mech-list li{padding:8px 0; border-bottom:1px solid var(--border);}
.mech-list li:last-child{border-bottom:none;}
.mech-list .mech-label{font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--text-dim); text-transform:uppercase; letter-spacing:0.05em; display:block; margin-bottom:3px;}

.dose-flag, .conflict-banner{
  border-radius:var(--radius); padding:12px 14px; margin-top:14px; font-size:13px; line-height:1.5;
}
.dose-flag{background:rgba(184,92,59,0.1); border:1px solid var(--warn); color:var(--text-mid);}

/* ---------- evidence panel internals ---------- */
.evidence-weight{
  display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono',monospace; font-size:11px;
  padding:5px 10px; border-radius:2px; margin-bottom:16px;
}
.evidence-weight.none{background:var(--panel-2); color:var(--text-dim); border:1px solid var(--border);}
.evidence-weight.single-source{background:rgba(184,134,59,0.1); color:var(--ochre-bright); border:1px solid var(--ochre-dim);}
.evidence-weight.multiple-consistent{background:rgba(122,155,92,0.12); color:var(--good); border:1px solid var(--good);}
.evidence-weight.multiple-conflicting{background:rgba(194,78,78,0.12); color:var(--conflict); border:1px solid var(--conflict);}

.empty-state{
  padding:32px 20px; text-align:center; color:var(--text-dim); font-size:13.5px;
  border:1px dashed var(--border-bright); border-radius:var(--radius);
}

.paper-card{
  background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
  padding:16px 18px; margin-bottom:12px;
}
.paper-card.outcome-negative{border-left:3px solid var(--warn);}
.paper-card.outcome-selective-avoidance{border-left:3px solid var(--evidence-bright);}
.paper-card.outcome-positive{border-left:3px solid var(--good);}
.paper-title{font-size:14px; font-weight:600; margin-bottom:4px; line-height:1.4;}
.paper-meta{font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--text-dim); margin-bottom:10px;}
.paper-outcome-tag{
  display:inline-block; font-family:'JetBrains Mono',monospace; font-size:9.5px; text-transform:uppercase;
  letter-spacing:0.06em; padding:2px 7px; border-radius:2px; margin-bottom:10px;
}
.paper-outcome-tag.positive{background:rgba(122,155,92,0.15); color:var(--good);}
.paper-outcome-tag.negative{background:rgba(184,92,59,0.15); color:var(--warn);}
.paper-outcome-tag.selective-avoidance{background:rgba(95,175,175,0.15); color:var(--evidence-bright);}
.paper-conditions{
  display:flex; flex-wrap:wrap; gap:8px; margin-bottom:10px;
}
.cond-chip{
  font-family:'JetBrains Mono',monospace; font-size:10.5px; background:var(--panel-2);
  border:1px solid var(--border-bright); border-radius:2px; padding:4px 8px; color:var(--text-mid);
}
.paper-result{font-size:13px; color:var(--text-mid); line-height:1.55; margin-bottom:8px;}
.paper-mechanism{font-size:12.5px; color:var(--text-dim); line-height:1.5; font-style:italic;}
.paper-divergence{
  margin-top:10px; padding-top:10px; border-top:1px dashed var(--border);
  font-size:12px; color:var(--ochre-bright); line-height:1.5;
}
.unverified-flag{
  display:inline-block; font-family:'JetBrains Mono',monospace; font-size:9px; color:var(--text-dim);
  margin-left:8px; text-transform:uppercase;
}

.conflict-banner{
  background:var(--conflict-bg); border:1px solid var(--conflict); color:var(--mineral-white);
  margin-bottom:18px;
}
.conflict-banner .cb-title{font-weight:600; font-size:13.5px; margin-bottom:6px; display:flex; align-items:center; gap:8px;}
.conflict-banner textarea{
  width:100%; margin-top:10px; background:var(--panel); border:1px solid var(--border-bright);
  border-radius:var(--radius); color:var(--mineral-white); font-family:'Space Grotesk',sans-serif;
  font-size:13px; padding:10px; resize:vertical; min-height:60px;
}
.conflict-banner .cb-hint{font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--text-dim); margin-top:6px;}
.comment-list{margin-top:10px; display:flex; flex-direction:column; gap:6px;}
.comment-item{
  background:var(--panel); border-radius:2px; padding:8px 10px; font-size:12.5px; color:var(--text-mid);
}

/* ---------- 3D scene ---------- */
.scene-section{padding:24px 32px 40px; border-top:1px solid var(--border); background:var(--panel);}
.scene-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;}
.scene-head h2{font-size:15px; font-weight:600; margin:0;}
.scene-hint{font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--text-dim);}
.scene-wrap{
  position:relative; background:var(--panel-2); border:1px solid var(--border); border-radius:var(--radius);
  overflow:hidden; touch-action:none;
}
#scene{display:block; width:100%; cursor:grab;}
#scene:active{cursor:grabbing;}
.scene-legend{
  position:absolute; bottom:12px; left:12px; font-family:'JetBrains Mono',monospace; font-size:10px;
  color:var(--text-mid); background:rgba(28,27,25,0.75); padding:8px 10px; border-radius:2px; line-height:1.6;
}
.scene-legend .li{display:flex; align-items:center; gap:6px; margin-bottom:2px;}
.scene-legend .sw{width:8px; height:8px; border-radius:50%; display:inline-block;}

footer{padding:22px 32px; font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--text-dim); text-align:center;}
</style>
</head>
<body>

<header>
  <div>
    <h1>Flotation Bench</h1>
    <div class="sub">Reagent Bonding Explorer — Theory vs. Literature</div>
  </div>
  <div class="legend">
    <span><span class="dot theory"></span>Theory panel — mechanistic reasoning</span>
    <span><span class="dot evidence"></span>Literature panel — paper-verified evidence</span>
  </div>
</header>

<div class="controls">
  <div class="control-group">
    <label for="mineral">Mineral</label>
    <select id="mineral"></select>
  </div>
  <div class="control-group">
    <label for="collector">Collector</label>
    <select id="collector"></select>
  </div>
  <div class="control-group">
    <label for="depressant">Depressant</label>
    <select id="depressant"></select>
  </div>
  <div class="control-group">
    <label for="ph">pH — <span id="phVal" class="mono">7.0</span></label>
    <div class="slider-row">
      <input type="range" id="ph" min="1" max="14" step="0.1" value="7">
    </div>
  </div>
  <div class="control-group">
    <label for="collectorDose">Collector dose — <span id="collectorDoseUnit" class="mono">g/t</span></label>
    <div class="slider-row">
      <input type="range" id="collectorDose" min="0" max="1000" step="5" value="400">
      <span class="slider-val" id="collectorDoseVal">400</span>
    </div>
    <div class="slider-note" id="collectorDoseNote"></div>
  </div>
  <div class="control-group">
    <label for="depressantDose">Depressant dose — <span id="depressantDoseUnit" class="mono">0-10 scale</span></label>
    <div class="slider-row">
      <input type="range" id="depressantDose" min="0" max="10" step="0.5" value="0">
      <span class="slider-val" id="depressantDoseVal">0</span>
    </div>
    <div class="slider-note" id="depressantDoseNote"></div>
  </div>
  <div class="control-group">
    <label for="particleSize">Particle size — <span id="particleSizeUnit" class="mono">\u00b5m</span></label>
    <div class="slider-row">
      <input type="range" id="particleSize" min="1" max="300" step="1" value="75">
      <span class="slider-val" id="particleSizeVal">75</span>
    </div>
    <div class="slider-note" id="particleSizeNote"></div>
  </div>
</div>

<main>
  <section class="panel theory">
    <div class="panel-head">
      <span class="dot theory"></span>
      <h2>Theory</h2>
      <span class="tag">Mechanistic</span>
    </div>
    <div class="scope-note" id="theoryScopeNote"></div>
    <div id="theoryBody"></div>
  </section>

  <section class="panel evidence">
    <div class="panel-head">
      <span class="dot evidence"></span>
      <h2>Literature</h2>
      <span class="tag" id="evidenceCountTag">0 papers</span>
    </div>
    <div id="conflictBannerWrap"></div>
    <div id="evidenceWeightWrap"></div>
    <div id="evidenceBody"></div>
  </section>
</main>

<section class="scene-section">
  <div class="scene-head">
    <h2>Molecular bonding view</h2>
    <span class="scene-hint">drag to rotate — updates live with the controls above</span>
  </div>
  <div class="scene-wrap">
    <canvas id="scene" width="1000" height="480"></canvas>
    <div class="scene-legend" id="sceneLegend"></div>
  </div>
</section>

<footer>Mechanistic predictions (Theory panel) are not validated against measured recovery data. Verified findings appear only in the Literature panel where a specific paper is on file.</footer>

<script id="data-module">
</script>
</body>
</html>
