// Helper: get all papers for a mineral+collector pair
function papersFor(mineralKey, collectorKey) {
  return PAPERS.filter(p => p.mineral === mineralKey && p.collector === collectorKey);
}

// Helper: derive evidence weight from paper count + outcome agreement
function evidenceWeightFor(mineralKey, collectorKey) {
  const papers = papersFor(mineralKey, collectorKey);
  if (papers.length === 0) return { level: "none", label: "No papers on file" };
  if (papers.length === 1) return { level: "single-source", label: "1 paper on file" };
  const outcomes = new Set(papers.map(p => p.outcome));
  if (outcomes.size === 1) return { level: "multiple-consistent", label: `${papers.length} papers, consistent outcome` };
  return { level: "multiple-conflicting", label: `${papers.length} papers, conflicting outcomes` };
}

// Helper: derive a reasonable dosage range from papers on file.
// Returns null if no paper reports a dose at all.
// Returns {mode:"single"} if only one paper reports a dose (no fabricated range).
// Returns {mode:"range"} if 2+ doses IN THE SAME UNIT are on file.
// Returns {mode:"mixed-units"} if papers report doses in different units —
// min/max across mismatched units (e.g. kg/t vs g/t) would be meaningless,
// so those are surfaced as separate single values instead of merged.
function doseRangeFor(mineralKey, collectorKey) {
  const papers = papersFor(mineralKey, collectorKey).filter(p => p.testedDose && p.testedDose.value !== null);
  if (papers.length === 0) return null;
  if (papers.length === 1) {
    const d = papers[0].testedDose;
    return { mode: "single", value: d.value, unit: d.unit, sourceCount: 1 };
  }
  const units = new Set(papers.map(p => p.testedDose.unit));
  if (units.size > 1) {
    return {
      mode: "mixed-units",
      values: papers.map(p => ({ value: p.testedDose.value, unit: p.testedDose.unit, paperId: p.id })),
      sourceCount: papers.length
    };
  }
  const values = papers.map(p => p.testedDose.value);
  const unit = papers[0].testedDose.unit;
  return {
    mode: "range",
    min: Math.min(...values), max: Math.max(...values), unit,
    sourceCount: papers.length
  };
}
// ============================================================
// FLOTATION BENCH v3 — THEORY ENGINE (Panel A)
// ============================================================
// Explicitly a MECHANISTIC / QUALITATIVE model, not a validated
// predictor. Real industrial flotation prediction (JKSimFloat,
// USIM PAC, MODSIM) uses empirical floatability-component models
// calibrated against real plant/pilot data per ore body — there
// is no chemistry-first industrial equivalent of what this panel
// does. This panel exists to show REASONING (why a bond might or
// might not form, given surface charge / HSAB / hydrophobicity),
// not to claim industrial-grade accuracy. That claim belongs to
// Panel B (papers.js), and only where a real paper backs it.
//
// Upgrade from v2: added an explicit hydrophobic-force term
// (extended DLVO / E-DLVO framing, per Xing et al. 2017, Minerals —
// "Role of Collectors and Depressants in Mineral Flotation: A
// Theoretical Analysis Based on Extended DLVO Theory"). E-DLVO
// treats a collector's role as creating hydrophobic attraction
// that must overcome van der Waals + electrostatic repulsion
// between particle and bubble — collector TAIL LENGTH matters
// more than concentration for this term, which v2 had no way to
// represent at all (v2 only modeled the head-group/surface
// interaction, never the tail's hydrophobic contribution).

function surfaceStateFor(mineral, pH) {
  if (!mineral.anisotropic) {
    const chargeSign = mineral.pzc === null ? "neutral" : (pH > mineral.pzc ? "negative" : pH < mineral.pzc ? "positive" : "neutral");
    return [{ label: mineral.name, fraction: 1.0, pzc: mineral.pzc, chargeSign, hsab: mineral.hsab }];
  }
  // Anisotropic (kaolinite): basal face permanently negative, edge face pH-driven.
  const edgeCharge = pH > mineral.edgePzc ? "negative" : pH < mineral.edgePzc ? "positive" : "neutral";
  return [
    { label: "basal", fraction: mineral.basalFraction, pzc: null, chargeSign: "negative", hsab: mineral.hsab },
    { label: "edge", fraction: 1 - mineral.basalFraction, pzc: mineral.edgePzc, chargeSign: edgeCharge, hsab: mineral.hsab }
  ];
}

// Hydrophobic term: qualitative only. Per E-DLVO literature, longer
// hydrophobic tails increase attachment force more than raising
// concentration does. We don't have per-collector tail-length data
// on file, so this returns a fixed qualitative descriptor per
// collector class rather than a fabricated numeric contribution —
// being honest that we're describing a mechanism, not computing one.
const HYDROPHOBIC_TAIL_NOTES = {
  fatty_acid: "Long-chain (typically C17-C18) hydrophobic tail — strong hydrophobic contribution once chemisorbed.",
  hydroxamate: "Moderate-chain hydrophobic tail (varies by formulation) — hydrophobic contribution secondary to the chelation bond itself.",
  amine: "Long-chain (typically C12, dodecylamine) hydrophobic tail — hydrophobic force is the main driver of attachment since the head-group interaction is purely electrostatic.",
  xanthate: "Short-to-moderate hydrophobic tail — attachment strength dominated by the covalent head-group bond, not the tail.",
  sulfonate: "Variable chain length — limited literature on file to characterize this term for sulfonate specifically."
};

function bondForSurface(surface, collector, pH, testedPHInfo) {
  const collectorChargeSign = collector.charge === "anionic" ? "negative" : "positive";
  const electrostaticFavorable = surface.chargeSign !== "neutral" && surface.chargeSign !== collectorChargeSign;
  const hsabMatch = (surface.hsab === "hard" && collector.hsab === "hard") || (surface.hsab === "soft" && collector.hsab === "soft");
  const pzcDelta = surface.pzc !== null ? Math.abs(pH - surface.pzc) : 0;

  let bondMode, strength, usedTestedPH = false;

  if (collector.mechanism.includes("chelation") && hsabMatch) {
    bondMode = "chemisorption (chelation)";
    if (testedPHInfo && testedPHInfo.testedPH !== undefined && testedPHInfo.testedPH !== null) {
      usedTestedPH = true;
      const delta = Math.abs(pH - testedPHInfo.testedPH);
      const [lo, hi] = testedPHInfo.testedPHRange || [testedPHInfo.testedPH - 1, testedPHInfo.testedPH + 1];
      const halfRange = Math.max((hi - lo) / 2, 0.5);
      const insideStatedRange = pH >= lo && pH <= hi;
      // A pH the source paper(s) explicitly report as within the
      // effective range shouldn't grade below moderate-to-strong just
      // because it's far from the specific tested optimum inside that
      // range — that was a real inconsistency (e.g. pH 8.5 grading
      // "weak-to-moderate" despite being the paper's own stated range
      // edge, not a point outside anything tested).
      if (delta <= halfRange * 0.5) strength = "strong";
      else if (delta <= halfRange || insideStatedRange) strength = "moderate-to-strong";
      else if (delta <= halfRange * 2) strength = "weak-to-moderate";
      else strength = "weak";
    } else {
      if (pzcDelta <= 1.5) strength = "strong";
      else if (pzcDelta <= 3.5) strength = "moderate-to-strong";
      else if (pzcDelta <= 5.5) strength = "weak-to-moderate";
      else strength = "weak";
    }
  } else if (collector.mechanism === "covalent chemisorption" && hsabMatch) {
    bondMode = "covalent chemisorption";
    if (testedPHInfo && testedPHInfo.testedPH !== undefined && testedPHInfo.testedPH !== null) {
      usedTestedPH = true;
      const delta = Math.abs(pH - testedPHInfo.testedPH);
      const [lo, hi] = testedPHInfo.testedPHRange || [testedPHInfo.testedPH - 2, testedPHInfo.testedPH + 2];
      const halfRange = Math.max((hi - lo) / 2, 1);
      const insideStatedRange = pH >= lo && pH <= hi;
      if (delta <= halfRange * 0.6) strength = "strong";
      else if (delta <= halfRange || insideStatedRange) strength = "moderate-to-strong";
      else strength = "weak-to-moderate";
    } else {
      if (pzcDelta <= 2.5) strength = "strong";
      else if (pzcDelta <= 5) strength = "moderate-to-strong";
      else strength = "weak-to-moderate";
    }
  } else if (electrostaticFavorable) {
    bondMode = "electrostatic (physisorption)";
    strength = pzcDelta > 2 ? "moderate-to-strong" : "weak-to-moderate";
  } else {
    bondMode = "unfavorable / minimal adsorption";
    strength = "weak";
  }

  return { bondMode, strength, electrostaticFavorable, hsabMatch, usedTestedPH, pzcDelta };
}

// Dose modifier: qualitative degradation if dose is far outside any
// known tested range. Without a per-collector adsorption-isotherm
// model (which would need real isotherm data we don't have), this
// is intentionally coarse — it flags "far from any tested dose" as
// a reason for lower confidence, not a precise strength computation.
function doseModifier(dose, doseRangeInfo) {
  if (!doseRangeInfo || dose === null || dose === undefined) return { flag: null };
  if (doseRangeInfo.mode === "single") {
    const ratio = dose / doseRangeInfo.value;
    if (ratio < 0.3 || ratio > 3) return { flag: "far-from-tested", note: `Far from the single reported dose (${doseRangeInfo.value} ${doseRangeInfo.unit}) — theory here is extrapolating well beyond any tested condition.` };
    return { flag: null };
  }
  if (doseRangeInfo.mode === "mixed-units") {
    return { flag: "mixed-units", note: `Papers on file report dose in different units (${doseRangeInfo.values.map(v => v.unit).join(", ")}) — shown separately rather than merged into one range.` };
  }
  if (dose < doseRangeInfo.min * 0.5 || dose > doseRangeInfo.max * 1.5) {
    return { flag: "far-from-tested", note: `Outside the reported dose range (${doseRangeInfo.min}\u2013${doseRangeInfo.max} ${doseRangeInfo.unit}) across ${doseRangeInfo.sourceCount} papers.` };
  }
  return { flag: null };
}

function predictTheory(mineralKey, collectorKey, pH, testedPHInfo, dose, doseRangeInfo) {
  const mineral = MINERALS[mineralKey];
  const collector = COLLECTORS[collectorKey];
  const surfaces = surfaceStateFor(mineral, pH);
  const surfaceResults = surfaces.map(s => ({ ...s, ...bondForSurface(s, collector, pH, testedPHInfo) }));
  const dominant = surfaceResults.reduce((a, b) => (b.fraction > a.fraction ? b : a));
  const doseInfo = doseModifier(dose, doseRangeInfo);

  return {
    surfaces: surfaceResults,
    dominant,
    hydrophobicNote: HYDROPHOBIC_TAIL_NOTES[collectorKey] || null,
    doseFlag: doseInfo.flag,
    doseNote: doseInfo.note || null,
    // Explicit disclosure string surfaced directly in the UI, not
    // buried — this panel is reasoning, not validated prediction.
    scopeNote: "Mechanistic prediction from surface-charge (PZC), HSAB matching, and hydrophobic-tail reasoning (extended DLVO). Not validated against measured recovery data \u2014 see the Literature panel for that."
  };
}
