// FLOTATION BENCH v3 — DEPRESSANT LOGIC
// ============================================================
// v2 bug this fixes: depressant "affinity score" was a single
// static number compared once against collector affinity, with
// no pH or dose sensitivity at all — same category of flat-
// strength bug as the v2 collector chelation branch, just never
// exercised by a test case yet. Fix follows the identical pattern:
// grade against a literature-tested pH/dose when we have one on
// file, fall back to a generic model otherwise, and say which one
// we're doing.

// Depressant papers — kept separate from mineral+collector PAPERS
// since a depressant's behavior is somewhat independent of which
// collector it's fighting against (it's competing for surface
// sites, not bonding to the collector itself).
const DEPRESSANT_PAPERS = [
  {
    id: "shmp-diaspore-01", depressant: "shmp", mineral: "diaspore", verified: true,
    testedPH: 6.0, testedPHRange: [5.5, 8.5],
    testedDose: { value: null, unit: null, range: null, singleSource: false },
    reportedResult: "SHMP adsorption onto diaspore surfaces (P-O-Al bridging) peaks near pH 6.0; effective depression reported across pH 5.5\u20138.5.",
    source: "J. Cent. South Univ. Technol., 2005",
    url: "https://link.springer.com/article/10.1007/s11771-005-0175-x"
  }
];

function depressantPapersFor(depressantKey, mineralKey) {
  return DEPRESSANT_PAPERS.filter(p => p.depressant === depressantKey && p.mineral === mineralKey);
}

// Generic (theory-only) depressant affinity scores — used only when
// no paper-backed pH is on file for this depressant+mineral pair.
// Kept explicitly as a fallback, not presented as literature-derived.
const GENERIC_DEPRESSANT_AFFINITY = {
  none: 0, sodium_silicate: 7, starch: 5, shmp: 9
};

function depressantStrength(depressantKey, mineralKey, collectorAffinityScore, pH, dose) {
  if (depressantKey === "none") {
    return { suppressed: false, strengthNote: "No depressant applied.", usedTestedPH: false };
  }
  const papers = depressantPapersFor(depressantKey, mineralKey);
  const genericAffinity = GENERIC_DEPRESSANT_AFFINITY[depressantKey] || 0;

  if (papers.length > 0) {
    // Grade depressant effectiveness by distance from tested pH, same
    // tiering pattern as the collector-side fix — but respecting the
    // paper's own stated effective range as a floor: a pH the paper
    // itself reports as "effective" (e.g. the edge of its stated
    // 5.5–8.5 window) should never grade lower than "moderate", even
    // if it's far from the specific tested optimum inside that range.
    // (Previously graded purely by distance-from-optimum, which could
    // call pH 8.5 "weak" even though the cited paper explicitly lists
    // 8.5 as within its effective range — a real inconsistency.)
    const paper = papers[0]; // if multiple exist later, this should surface all, same as PAPERS
    const delta = Math.abs(pH - paper.testedPH);
    const [lo, hi] = paper.testedPHRange || [paper.testedPH - 1, paper.testedPH + 1];
    const halfRange = Math.max((hi - lo) / 2, 0.5);
    const insideStatedRange = pH >= lo && pH <= hi;
    let effectiveness;
    if (delta <= halfRange * 0.5) effectiveness = "strong";
    else if (delta <= halfRange || insideStatedRange) effectiveness = "moderate";
    else effectiveness = "weak";

    const dosePull = (dose / 10) * genericAffinity; // dose slider still 0-10 pending a real dosage isotherm source
    const suppressed = effectiveness !== "weak" && dosePull > collectorAffinityScore * 0.5;

    return {
      suppressed, effectiveness, usedTestedPH: true,
      strengthNote: `Graded against ${paper.source} (tested pH ${paper.testedPH}, range ${lo}\u2013${hi}). Depressant effectiveness at pH ${pH}: ${effectiveness}.`,
      citation: paper
    };
  }

  // Fallback: generic affinity-score comparison (old v2 behavior),
  // clearly flagged as not literature-graded for pH.
  const dosePull = genericAffinity * (dose / 10);
  const suppressed = dosePull > collectorAffinityScore;
  return {
    suppressed, effectiveness: suppressed ? "moderate" : "weak", usedTestedPH: false,
    strengthNote: `No pair-specific paper on file for ${depressantKey}+${mineralKey} \u2014 using generic affinity-score comparison only, not graded against a tested pH.`,
    citation: null
  };
}

</script>
<script id="app-logic">
// ============================================================
// APP LOGIC — wires the data/theory/depressant modules (loaded
// above) to the UI, handles live recompute, and drives the 3D
// molecular bonding scene.
// ============================================================

const els = {
  mineral: document.getElementById('mineral'),
  collector: document.getElementById('collector'),
  depressant: document.getElementById('depressant'),
  ph: document.getElementById('ph'), phVal: document.getElementById('phVal'),
  collectorDose: document.getElementById('collectorDose'),
  collectorDoseVal: document.getElementById('collectorDoseVal'),
  collectorDoseUnit: document.getElementById('collectorDoseUnit'),
  collectorDoseNote: document.getElementById('collectorDoseNote'),
  depressantDose: document.getElementById('depressantDose'),
  depressantDoseVal: document.getElementById('depressantDoseVal'),
  depressantDoseUnit: document.getElementById('depressantDoseUnit'),
  depressantDoseNote: document.getElementById('depressantDoseNote'),
  particleSize: document.getElementById('particleSize'),
  particleSizeVal: document.getElementById('particleSizeVal'),
  particleSizeUnit: document.getElementById('particleSizeUnit'),
  particleSizeNote: document.getElementById('particleSizeNote'),
  theoryScopeNote: document.getElementById('theoryScopeNote'),
  theoryBody: document.getElementById('theoryBody'),
  evidenceCountTag: document.getElementById('evidenceCountTag'),
  conflictBannerWrap: document.getElementById('conflictBannerWrap'),
  evidenceWeightWrap: document.getElementById('evidenceWeightWrap'),
  evidenceBody: document.getElementById('evidenceBody'),
  sceneLegend: document.getElementById('sceneLegend'),
};

// ---------- populate selectors ----------
function fillSelect(el, obj, keyToLabel) {
  el.innerHTML = Object.keys(obj).map(k => `<option value="${k}">${keyToLabel(obj[k])}</option>`).join('');
}
fillSelect(els.mineral, MINERALS, m => m.name);
fillSelect(els.collector, COLLECTORS, c => c.name);
fillSelect(els.depressant, DEPRESSANTS, d => d.name);
els.mineral.value = 'gibbsite';
els.collector.value = 'hydroxamate';
els.depressant.value = 'none';

// Comments are session-local only (no backend exists to persist them) —
// flagged explicitly in the UI rather than implying they're saved.
const sessionComments = {}; // keyed by "mineral|collector"

// ---------- particle size units (varies by what's in the papers) ----------
// Per your request: vary units for realism rather than forcing everything
// into one system. Only a couple of papers on file mention particle size at
// all, so this is mostly a placeholder control until more sources are added —
// flagged as such via particleSizeNote.
const PARTICLE_SIZE_UNITS = { default: { unit: '\u00b5m', min: 1, max: 300, step: 1 } };

function strengthRank(s) {
  return { weak: 0, 'weak-to-moderate': 1, 'moderate-to-strong': 2, strong: 3 }[s] ?? 0;
}

function render() {
  const mineralKey = els.mineral.value, collectorKey = els.collector.value, depressantKey = els.depressant.value;
  const mineral = MINERALS[mineralKey], collector = COLLECTORS[collectorKey];
  const pH = parseFloat(els.ph.value);
  const collectorDose = parseFloat(els.collectorDose.value);
  const depressantDose = parseFloat(els.depressantDose.value);
  const particleSize = parseFloat(els.particleSize.value);

  els.phVal.textContent = pH.toFixed(1);
  els.depressantDoseVal.textContent = depressantDose.toFixed(1);
  els.particleSizeVal.textContent = particleSize.toFixed(0);

  // ---------------- gather papers / evidence ----------------
  const papers = papersFor(mineralKey, collectorKey);
  const weight = evidenceWeightFor(mineralKey, collectorKey);
  const doseRange = doseRangeFor(mineralKey, collectorKey);

  // collector dose slider bounds + unit follow the papers on file when we have them
  if (doseRange && doseRange.mode === 'range') {
    els.collectorDose.min = Math.floor(doseRange.min * 0.5);
    els.collectorDose.max = Math.ceil(doseRange.max * 1.5);
    els.collectorDoseUnit.textContent = doseRange.unit;
    els.collectorDoseNote.textContent = `Reported range: ${doseRange.min}\u2013${doseRange.max} ${doseRange.unit} across ${doseRange.sourceCount} papers.`;
    els.collectorDoseNote.className = 'slider-note';
  } else if (doseRange && doseRange.mode === 'single') {
    els.collectorDoseUnit.textContent = doseRange.unit;
    els.collectorDoseNote.textContent = `Single reported dose on file: ${doseRange.value} ${doseRange.unit} (only one paper reports dosage for this pair — not a range).`;
    els.collectorDoseNote.className = 'slider-note warn';
  } else if (doseRange && doseRange.mode === 'mixed-units') {
    els.collectorDoseUnit.textContent = 'mixed units';
    els.collectorDoseNote.textContent = `Papers report dose in different units (${doseRange.values.map(v=>`${v.value} ${v.unit}`).join(', ')}) — not merged into a range.`;
    els.collectorDoseNote.className = 'slider-note warn';
  } else {
    els.collectorDoseUnit.textContent = 'g/t (assumed)';
    els.collectorDoseNote.textContent = 'No dosage reported in any paper on file for this pair — slider has no literature grounding here.';
    els.collectorDoseNote.className = 'slider-note warn';
  }

  els.depressantDoseUnit.textContent = '0\u201310 scale (generic)';
  els.depressantDoseNote.textContent = depressantKey === 'none' ? '' : 'Depressant dosage is on a generic 0\u201310 competitive-affinity scale, not literature-calibrated units, unless a paper-specific pH is shown in the readout below.';

  els.particleSizeUnit.textContent = PARTICLE_SIZE_UNITS.default.unit;
  els.particleSizeNote.textContent = 'Particle size is not yet quantitatively linked to bond strength in this model \u2014 shown for reference since multiple papers flag it as a real factor outside current scope.';

  // ---------------- theory panel ----------------
  // Combine ALL papers with a testedPH into one consensus reference,
  // rather than arbitrarily using whichever comes first in array order
  // (that was a real bug: gib-hyd-01's narrow [9.5,10.5] range was being
  // used instead of gib-hyd-02's wider [8.5,10.5] range depending on
  // array position, silently changing which paper's conditions the
  // theory panel was actually graded against). Consensus = midpoint of
  // all reported testedPH values, range = widest lo/hi across all papers
  // that reported one \u2014 the most defensible single summary when
  // multiple sources exist, rather than picking one paper's number.
  const papersWithPH = papers.filter(p => p.testedPH !== null && p.testedPH !== undefined);
  let testedPHInfo = null;
  if (papersWithPH.length > 0) {
    const phValues = papersWithPH.map(p => p.testedPH);
    const avgPH = phValues.reduce((a,b) => a+b, 0) / phValues.length;
    const allRangeBounds = papersWithPH.flatMap(p => p.testedPHRange || [p.testedPH, p.testedPH]);
    testedPHInfo = {
      testedPH: avgPH,
      testedPHRange: [Math.min(...allRangeBounds), Math.max(...allRangeBounds)],
      sourceCount: papersWithPH.length
    };
  }
  const theory = predictTheory(mineralKey, collectorKey, pH, testedPHInfo, collectorDose, doseRange);
  const depResult = depressantStrength(depressantKey, mineralKey, collector.hsab === 'hard' ? 8 : 8, pH, depressantDose);

  els.theoryScopeNote.textContent = theory.scopeNote;
  renderTheoryBody(theory, mineral, collector, depressantKey, depResult, pH);

  // ---------------- evidence panel ----------------
  els.evidenceCountTag.textContent = `${papers.length} paper${papers.length === 1 ? '' : 's'}`;
  renderEvidenceWeight(weight);
  renderEvidenceBody(papers, mineralKey, collectorKey);
  renderConflictBanner(theory, papers, mineralKey, collectorKey);

  // ---------------- 3D scene ----------------
  updateScene({ mineral, collector, mineralKey, collectorKey, theory, depressantKey, depResult, pH });

  return { theory, papers, weight };
}

function renderTheoryBody(theory, mineral, collector, depressantKey, depResult, pH) {
  const dom = theory.dominant;
  const isAnisotropic = theory.surfaces.length > 1;

  let html = '';
  html += `<div class="strength-readout">
    <span class="strength-value ${dom.strength}">${dom.strength.replace(/-/g,' ')}</span>
    <span class="strength-label">${dom.bondMode}${dom.usedTestedPH ? ' \u00b7 graded vs. tested pH' : ' \u00b7 PZC-distance fallback'}</span>
  </div>`;

  // PZC / pH diagram
  html += `<div class="diagram-wrap">`;
  theory.surfaces.forEach(s => {
    const pzcDisplay = s.pzc !== null ? s.pzc : null;
    html += `<div style="margin-bottom:${theory.surfaces.length>1?'14px':'0'}">
      <div class="mono" style="font-size:11px;color:var(--text-dim);margin-bottom:4px;">
        ${isAnisotropic ? s.label + ' face (' + (s.fraction*100).toFixed(0) + '% area) \u2014 ' : ''}${s.chargeSign} at pH ${pH.toFixed(1)}${pzcDisplay!==null ? ', PZC ' + pzcDisplay : ' (permanent charge, not pH-driven)'}
      </div>
      <div class="pzc-bar">
        <div class="zone pos" style="width:${pzcDisplay!==null ? Math.min(100,(pzcDisplay/14)*100) : 0}%"></div>
        <div class="zone neg" style="width:${pzcDisplay!==null ? Math.min(100,100-(pzcDisplay/14)*100) : 100}%"></div>
        ${pzcDisplay!==null ? `<div class="marker" style="left:${(pzcDisplay/14)*100}%"><span class="mtag">PZC ${pzcDisplay}</span></div>` : ''}
        <div class="marker ph-marker" style="left:${Math.min(100,(pH/14)*100)}%"><span class="mtag" style="top:38px;color:var(--ochre-bright);">pH ${pH.toFixed(1)}</span></div>
      </div>
      <div class="pzc-axis"><span>1 (acidic)</span><span>14 (alkaline)</span></div>
    </div>`;
  });
  html += `</div>`;

  html += `<ul class="mech-list">
    <li><span class="mech-label">HSAB match</span>${mineral.hsab} surface \u00d7 ${collector.hsab} collector \u2014 ${dom.hsabMatch ? 'match' : 'no match'}</li>
    <li><span class="mech-label">Hydrophobic tail (E-DLVO)</span>${theory.hydrophobicNote || 'No data on file.'}</li>
  </ul>`;

  if (depressantKey !== 'none') {
    html += `<div class="dose-flag"><strong>Depressant \u2014 ${DEPRESSANTS[depressantKey].name}:</strong> ${depResult.strengthNote}${depResult.suppressed ? ' Collector bonding may be suppressed under these conditions.' : ''}</div>`;
  }

  if (theory.doseFlag) {
    html += `<div class="dose-flag">${theory.doseNote}</div>`;
  }

  els.theoryBody.innerHTML = html;
}

function renderEvidenceWeight(weight) {
  els.evidenceWeightWrap.innerHTML = `<div class="evidence-weight ${weight.level}">${weight.label}</div>`;
}

function renderEvidenceBody(papers, mineralKey, collectorKey) {
  if (papers.length === 0) {
    els.evidenceBody.innerHTML = `<div class="empty-state">No papers on file for ${MINERALS[mineralKey].name} + ${COLLECTORS[collectorKey].name}. The Theory panel is reasoning from general surface chemistry only \u2014 nothing here has been checked against a real study yet.</div>`;
    return;
  }
  els.evidenceBody.innerHTML = papers.map(p => `
    <div class="paper-card outcome-${p.outcome}">
      <span class="paper-outcome-tag ${p.outcome}">${p.outcome.replace(/-/g,' ')}</span>
      ${!p.verified ? '<span class="unverified-flag">found via search \u2014 not independently read in full</span>' : ''}
      <div class="paper-title">${p.title}</div>
      <div class="paper-meta">${p.authors ? p.authors + ' \u00b7 ' : ''}${p.year ? p.year + ' \u00b7 ' : ''}${p.source}</div>
      <div class="paper-conditions">
        ${p.testedPH !== null && p.testedPH !== undefined ? `<span class="cond-chip">pH ${p.testedPH}${p.testedPHRange ? ' (range ' + p.testedPHRange[0] + '\u2013' + p.testedPHRange[1] + ')' : ''}</span>` : ''}
        ${p.testedDose && p.testedDose.value !== null ? `<span class="cond-chip">${p.testedDose.value} ${p.testedDose.unit}${p.testedDose.singleSource ? ' (single source)' : ''}</span>` : ''}
        ${p.testedParticleSize ? `<span class="cond-chip">${p.testedParticleSize.value} ${p.testedParticleSize.unit}</span>` : ''}
      </div>
      <div class="paper-result">${p.reportedResult}</div>
      <div class="paper-mechanism">${p.mechanism}</div>
      ${p.divergenceNote ? `<div class="paper-divergence">\u25b8 ${p.divergenceNote}</div>` : ''}
    </div>
  `).join('');
}

function renderConflictBanner(theory, papers, mineralKey, collectorKey) {
  const domStrength = theory.dominant.strength;
  const theoryPredictsBonding = strengthRank(domStrength) >= 2; // moderate-to-strong or strong

  const negativeOrAvoidance = papers.filter(p => p.outcome === 'negative' || p.outcome === 'selective-avoidance');
  const outcomes = new Set(papers.map(p => p.outcome));
  const papersConflictInternally = outcomes.size > 1;
  const theoryVsEvidenceConflict = theoryPredictsBonding && negativeOrAvoidance.length > 0;

  if (!papersConflictInternally && !theoryVsEvidenceConflict) {
    els.conflictBannerWrap.innerHTML = '';
    return;
  }

  const key = `${mineralKey}|${collectorKey}`;
  const comments = sessionComments[key] || [];

  let reasons = [];
  if (theoryVsEvidenceConflict) reasons.push('Theory predicts favorable bonding, but at least one paper on file reports a negative or selective-avoidance outcome for this exact pair.');
  if (papersConflictInternally) reasons.push('Papers on file report different outcomes for this pair \u2014 see individual divergence notes below.');

  els.conflictBannerWrap.innerHTML = `
    <div class="conflict-banner">
      <div class="cb-title">\u26a0 Papers disagree with theoretical prediction here</div>
      ${reasons.map(r => `<div>${r}</div>`).join('')}
      <div class="cb-hint">What do you think explains the difference? (session-only \u2014 not saved between visits, no backend storage exists yet)</div>
      <textarea id="commentInput" placeholder="e.g. site density, particle aggregation, ore source variability..."></textarea>
      <div class="comment-list" id="commentList">
        ${comments.map(c => `<div class="comment-item">${c}</div>`).join('')}
      </div>
    </div>
  `;
  const input = document.getElementById('commentInput');
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      const val = input.value.trim();
      if (val) {
        sessionComments[key] = sessionComments[key] || [];
        sessionComments[key].push(val);
        input.value = '';
        renderConflictBanner(theory, papers, mineralKey, collectorKey);
      }
    }
  });
}

// ============================================================
// 3D MOLECULAR BONDING SCENE
// ============================================================
const canvas = document.getElementById('scene');
const ctx = canvas.getContext('2d');
let rotY = 0.4, rotX = -0.25, dragging = false, lastX = 0, lastY = 0, autoRotate = true;
let sceneState = null;

function resizeCanvas() {
  const wrap = canvas.parentElement;
  const w = wrap.clientWidth;
  canvas.width = w; canvas.height = Math.max(360, Math.min(520, w * 0.42));
}
window.addEventListener('resize', resizeCanvas);

canvas.addEventListener('pointerdown', e => { dragging = true; autoRotate = false; lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); });
canvas.addEventListener('pointermove', e => {
  if (!dragging) return;
  rotY += (e.clientX - lastX) * 0.008;
  rotX += (e.clientY - lastY) * 0.008;
  rotX = Math.max(-1.2, Math.min(1.2, rotX));
  lastX = e.clientX; lastY = e.clientY;
});
canvas.addEventListener('pointerup', () => { dragging = false; });
canvas.addEventListener('pointerleave', () => { dragging = false; });

function project(x, y, z, cx, cy, scale) {
  const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
  const cosX = Math.cos(rotX), sinX = Math.sin(rotX);
  let x1 = x * cosY - z * sinY;
  let z1 = x * sinY + z * cosY;
  let y1 = y * cosX - z1 * sinX;
  let z2 = y * sinX + z1 * cosX;
  const persp = 480 / (480 + z2);
  return { x: cx + x1 * scale * persp, y: cy + y1 * scale * persp, depth: z2, persp };
}

const HSAB_COLOR = { hard: '#B8863B', soft: '#6FA3C9', borderline: '#9A9488' };

function drawScene() {
  const w = canvas.width, h = canvas.height;
  ctx.clearRect(0, 0, w, h);
  ctx.fillStyle = '#2C2A27';
  ctx.fillRect(0, 0, w, h);

  if (!sceneState) { requestAnimationFrame(drawScene); return; }
  const { mineral, collector, theory, depResult } = sceneState;
  const cx = w / 2, cy = h / 2 + 20, scale = Math.min(w, h) * 0.34;

  const dom = theory.dominant;
  const strengthColor = { strong: '#7A9B5C', 'moderate-to-strong': '#D9A24E', 'weak-to-moderate': '#B85C3B', weak: '#C24E4E' }[dom.strength];
  const bonded = dom.strength !== 'weak';
  const suppressed = depResult && depResult.suppressed;

  // ---- surface lattice (6x6 grid) ----
  const gridN = 6, spacing = 0.34;
  const siteColor = HSAB_COLOR[mineral.hsab] || '#9A9488';
  const isAnisotropic = mineral.anisotropic;
  const pts = [];
  for (let i = 0; i < gridN; i++) {
    for (let j = 0; j < gridN; j++) {
      const x = (i - (gridN - 1) / 2) * spacing;
      const z = (j - (gridN - 1) / 2) * spacing;
      pts.push({ x, y: 0, z, i, j });
    }
  }
  pts.sort((a, b) => project(a.x, a.y, a.z, cx, cy, scale).depth - project(b.x, b.y, b.z, cx, cy, scale).depth);

  pts.forEach(p => {
    const proj = project(p.x, p.y, p.z, cx, cy, scale);
    const isEdgeBand = isAnisotropic && (p.i === 0 || p.i === gridN - 1 || p.j === 0 || p.j === gridN - 1);
    const col = isEdgeBand ? '#D9A24E' : siteColor;
    const r = 5 * proj.persp;
    ctx.beginPath();
    ctx.arc(proj.x, proj.y, r, 0, Math.PI * 2);
    ctx.fillStyle = col;
    ctx.globalAlpha = 0.55 + 0.25 * proj.persp;
    ctx.fill();
    ctx.globalAlpha = 1;
  });

  // ---- pulsing charge field ring ----
  const t = performance.now() / 1000;
  const pulse = (Math.sin(t * 1.6) + 1) / 2;
  const chargeSign = dom.electrostaticFavorable !== undefined ? (theory.surfaces[0].chargeSign) : 'neutral';
  const ringColor = chargeSign === 'negative' ? '#6FA3C9' : chargeSign === 'positive' ? '#B85C3B' : '#9A9488';
  for (let ring = 0; ring < 2; ring++) {
    const ringR = (0.9 + ring * 0.5 + pulse * 0.3) * scale;
    ctx.beginPath();
    ctx.ellipse(cx, cy, ringR, ringR * 0.32, 0, 0, Math.PI * 2);
    ctx.strokeStyle = ringColor;
    ctx.globalAlpha = 0.18 - ring * 0.06;
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  // ---- collector molecule (tail + head group) ----
  const bobHeight = bonded ? 0.55 + Math.sin(t * 1.2) * 0.03 : 0.55 + Math.sin(t*1.2)*0.03 + (suppressed ? 0.35 : 0);
  const headProj = project(0, -bobHeight, 0, cx, cy, scale);
  const tailTopProj = project(0.15, -bobHeight - 0.9, -0.1, cx, cy, scale);

  // tail (gray line)
  ctx.beginPath();
  ctx.moveTo(tailTopProj.x, tailTopProj.y);
  ctx.lineTo(headProj.x, headProj.y);
  ctx.strokeStyle = '#9A9488';
  ctx.lineWidth = 3 * headProj.persp;
  ctx.stroke();

  // head group
  const headColor = collector.charge === 'anionic' ? '#B8863B' : '#6FA3C9';
  ctx.beginPath();
  ctx.arc(headProj.x, headProj.y, 9 * headProj.persp, 0, Math.PI * 2);
  ctx.fillStyle = headColor;
  ctx.fill();
  ctx.strokeStyle = '#EDE7DD';
  ctx.lineWidth = 1;
  ctx.stroke();

  // bond line (surface site to head group) — color-coded by strength, dashed if suppressed
  if (bonded) {
    const siteProj = project(0, 0, 0, cx, cy, scale);
    ctx.beginPath();
    ctx.moveTo(siteProj.x, siteProj.y);
    ctx.lineTo(headProj.x, headProj.y);
    ctx.strokeStyle = suppressed ? '#6FA3C9' : strengthColor;
    ctx.lineWidth = suppressed ? 2 : (dom.strength === 'strong' ? 4 : 2.5);
    if (suppressed) ctx.setLineDash([5, 5]); else ctx.setLineDash([]);
    ctx.stroke();
    ctx.setLineDash([]);
  }

  requestAnimationFrame(() => {
    if (autoRotate && !dragging) rotY += 0.0025;
    drawScene();
  });
}

function updateScene(state) {
  sceneState = state;
  const suppressedNote = state.depResult && state.depResult.suppressed ? '<div class="li"><span class="sw" style="background:#6FA3C9"></span>Bond suppressed by depressant (dashed)</div>' : '';
  els.sceneLegend.innerHTML = `
    <div class="li"><span class="sw" style="background:${{strong:'#7A9B5C','moderate-to-strong':'#D9A24E','weak-to-moderate':'#B85C3B',weak:'#C24E4E'}[state.theory.dominant.strength]}"></span>Bond: ${state.theory.dominant.strength.replace(/-/g,' ')}</div>
    <div class="li"><span class="sw" style="background:${state.collector.charge==='anionic'?'#B8863B':'#6FA3C9'}"></span>${state.collector.name} (${state.collector.charge})</div>
    ${suppressedNote}
  `;
}

// ---------- wire up live recompute ----------
['mineral','collector','depressant','ph','collectorDose','depressantDose','particleSize'].forEach(id => {
  els[id].addEventListener('input', render);
});

resizeCanvas();
render();
requestAnimationFrame(drawScene);
</script>

</body>
</html>
